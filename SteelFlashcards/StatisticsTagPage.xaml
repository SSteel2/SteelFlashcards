<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteelFlashcards.StatisticsTagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteelFlashcards"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" Margin="12,12,0,0"> <!--Top row with tag and mastery counter-->
            <Border x:Name="TagBorder" BorderThickness="1" BorderBrush="Black" CornerRadius="12">
                <TextBlock Text="{x:Bind ViewModel.SelectedTag.TagName}" Padding="8,2" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.SelectedTag.GetWordsMasteryString()}" Margin="20,4,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Padding="12">
            <Button Content="Back" Command="{x:Bind ViewModel.GoBackCommand}"/>
        </StackPanel>
        <ListView ItemsSource="{x:Bind ViewModel.SelectedTag.Words}" Margin="12" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WordStatistic">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Word}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind LastAttempt}" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="{x:Bind TotalAttemptsString()}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind RecentAttemptsString()}" VerticalAlignment="Center"/>
                                <SymbolIcon Symbol="SolidStar"
                                            Foreground="Gold"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMastered, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Expander.Header>
                        <ListView ItemsSource="{x:Bind Answers}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Answer">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind AttemptDateTime}"/>
                                        <TextBlock Text="{x:Bind IsCorrect}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
