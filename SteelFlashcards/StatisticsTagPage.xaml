<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteelFlashcards.StatisticsTagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SteelFlashcards"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <GridLength x:Key="ColWord">*</GridLength>
        <GridLength x:Key="ColLastAttempt">200</GridLength>
        <GridLength x:Key="ColTotal">80</GridLength>
        <GridLength x:Key="ColRecent">80</GridLength>
        <GridLength x:Key="ColMastered">80</GridLength>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- tag / mastery / Back -->
            <RowDefinition Height="Auto"/> <!-- Table header -->
            <RowDefinition Height="*"/>    <!-- Statistics content -->
        </Grid.RowDefinitions>

        <!--Top row with tag, mastery counter and Back button-->
        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="TagBorder" BorderThickness="1" BorderBrush="Black" CornerRadius="12">
                    <TextBlock Text="{x:Bind ViewModel.SelectedTag.TagName}" Padding="8,2" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.SelectedTag.GetWordsMasteryString()}" Margin="20,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Back" Command="{x:Bind ViewModel.GoBackCommand}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Table header -->
        <Grid Grid.Row="1" Margin="12,12,12,0" Padding="16,0,60,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ColWord}"/>
                <ColumnDefinition Width="{StaticResource ColLastAttempt}"/>
                <ColumnDefinition Width="{StaticResource ColTotal}"/>
                <ColumnDefinition Width="{StaticResource ColRecent}"/>
                <ColumnDefinition Width="{StaticResource ColMastered}"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Word" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Last Attempt" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Total" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Recent" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Mastered" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Grid>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedTag.Words}" Margin="12,0,12,12"
                  SelectionMode="Single"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WordStatistic">
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="0" Padding="0">
                        <Expander.Header>
                            <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColWord}"/>
                                    <ColumnDefinition Width="{StaticResource ColLastAttempt}"/>
                                    <ColumnDefinition Width="{StaticResource ColTotal}"/>
                                    <ColumnDefinition Width="{StaticResource ColRecent}"/>
                                    <ColumnDefinition Width="{StaticResource ColMastered}"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Word}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind LastAttempt}" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind TotalAttemptsString()}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind RecentAttemptsString()}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <SymbolIcon Grid.Column="4"
                                            Symbol="SolidStar"
                                            Foreground="Gold"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{x:Bind IsMastered, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Expander.Header>
                        <ListView ItemsSource="{x:Bind Answers}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Answer">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind AttemptDateTime}"/>
                                        <TextBlock Text="{x:Bind IsCorrect}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
